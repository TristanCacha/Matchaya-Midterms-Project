CI_ENVIRONMENT=development
app.baseURL='http://localhost:8084/'

database.default.hostname=127.0.0.1
database.default.database=matchaya_pos
database.default.username=root
database.default.password=
database.default.DBDriver=MySQLi
database.default.DBPrefix=
database.default.port=3306

MEDIA_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Vercel database variables (set in its dashboard, not in a committed file):
# DB_HOST=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_PORT=3306

# InfinityFree: create a separate MySQL database in its control panel, then
# replace the seven values above in a private .env uploaded to htdocs.
# Use CI_ENVIRONMENT=production, the HTTPS subdomain as app.baseURL, and
# MEDIA_DRIVER=local. Never point this site at the localhost database.
